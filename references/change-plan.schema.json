{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ray PPT Generator Change Plan",
  "type": "object",
  "required": ["summary", "changes"],
  "properties": {
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "changes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "type", "targets", "request", "impact"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "enum": [
              "content",
              "item-count",
              "asset",
              "layout",
              "add-slide",
              "delete-slide",
              "split-slide",
              "reorder-slide",
              "style"
            ]
          },
          "command": {
            "enum": [
              "set-text",
              "add-item",
              "remove-item",
              "replace-image",
              "add-slide",
              "delete-slide",
              "move-slide",
              "split-slide",
              "custom-edit"
            ]
          },
          "targets": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "request": {
            "type": "string",
            "minLength": 1
          },
          "impact": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "typographyAuthorization": {
            "type": "object",
            "required": ["role", "properties"],
            "properties": {
              "role": {
                "type": "string",
                "minLength": 1
              },
              "itemId": {
                "type": "string",
                "minLength": 1
              },
              "properties": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "enum": ["fontFamily", "fontWeight"]
                }
              },
              "fontFamily": {
                "type": "string",
                "minLength": 1
              },
              "fontWeight": {
                "type": "number",
                "minimum": 1,
                "maximum": 1000
              }
            },
            "additionalProperties": false
          },
          "dependsOn": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "status": {
            "enum": ["pending", "applied", "verified", "blocked"]
          },
          "slide": {
            "type": "string",
            "minLength": 1
          },
          "newSlide": {
            "type": "string",
            "minLength": 1
          },
          "layoutDecision": {
            "type": "string",
            "minLength": 1
          },
          "layoutTreatment": {
            "type": "string",
            "minLength": 1
          },
          "reviewedLayout": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": "string"
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "assetName": {
            "type": "string",
            "minLength": 1
          },
          "src": {
            "type": "string",
            "minLength": 1
          },
          "alt": {
            "type": "string",
            "minLength": 1
          },
          "fit": {
            "enum": ["contain", "cover"]
          },
          "imageWidth": {
            "type": "integer",
            "minimum": 1
          },
          "imageHeight": {
            "type": "integer",
            "minimum": 1
          },
          "aspectRatio": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "imageLayout": {
            "enum": [
              "portrait",
              "square",
              "landscape-standard",
              "landscape-wide"
            ]
          },
          "itemId": {
            "type": "string",
            "minLength": 1
          },
          "moveItemIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "after": {
            "type": "string",
            "minLength": 1
          },
          "item": {
            "type": "object",
            "required": ["id", "title", "body"],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "body": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "html": {
            "type": "string",
            "minLength": 1
          },
          "assertions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["type"],
              "properties": {
                "type": {
                  "enum": [
                    "text-equals",
                    "text-includes",
                    "item-count",
                    "item-exists",
                    "item-absent",
                    "item-text-equals",
                    "sequential-numbering",
                    "image-src-equals",
                    "image-alt-equals",
                    "image-layout-equals",
                    "image-dimensions-equal",
                    "image-fit-equals",
                    "slide-exists",
                    "slide-absent",
                    "slide-after",
                    "slide-layout-equals",
                    "slide-attribute-equals"
                  ]
                },
                "slide": {
                  "type": "string",
                  "minLength": 1
                },
                "target": {
                  "type": "string",
                  "minLength": 1
                },
                "itemId": {
                  "type": "string",
                  "minLength": 1
                },
                "role": {
                  "type": "string",
                  "minLength": 1
                },
                "expected": {}
              }
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
