{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ray PPT Generator Added-Slide Layout Plan",
  "type": "object",
  "required": ["schemaVersion", "updatedAt", "status", "decisions", "review"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "updatedAt": { "type": "string", "format": "date-time" },
    "status": { "enum": ["review-required", "passed", "failed"] },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "changeId",
          "slide",
          "request",
          "after",
          "narrativeRole",
          "contentShape",
          "intent",
          "signals",
          "itemCount",
          "density",
          "requestedLayout",
          "source",
          "selectedLayout",
          "styleTreatment",
          "prototypeSlide",
          "candidates",
          "rejections",
          "scoreGap",
          "confidence",
          "status",
          "review"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "changeId": { "type": "string", "minLength": 1 },
          "slide": { "type": "string", "minLength": 1 },
          "request": { "type": "string", "minLength": 1 },
          "after": { "type": "string", "minLength": 1 },
          "narrativeRole": { "type": "string", "minLength": 1 },
          "contentShape": { "type": "string", "minLength": 1 },
          "intent": { "type": "string", "minLength": 1 },
          "signals": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "itemCount": { "type": "integer", "minimum": 0 },
          "density": { "enum": ["speaker-led", "balanced", "dense"] },
          "requestedLayout": { "type": ["string", "null"] },
          "source": { "enum": ["inferred", "user"] },
          "selectedLayout": { "type": "string", "minLength": 1 },
          "styleTreatment": { "type": "string", "minLength": 1 },
          "prototypeSlide": { "type": "string", "minLength": 1 },
          "candidates": { "type": "array", "minItems": 1 },
          "rejections": { "type": "array" },
          "scoreGap": { "type": "number" },
          "confidence": { "enum": ["high", "medium", "low"] },
          "status": { "const": "review-required" },
          "review": { "type": "null" }
        },
        "additionalProperties": false
      }
    },
    "review": { "type": ["object", "null"] }
  },
  "additionalProperties": false
}
