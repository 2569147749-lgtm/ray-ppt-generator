{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ray PPT Generator Initial Deck Plan",
  "type": "object",
  "required": [
    "schemaVersion",
    "template",
    "updatedAt",
    "status",
    "brief",
    "sources",
    "narrative",
    "slides",
    "coverage",
    "findings",
    "review"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "template": { "type": "string", "minLength": 1 },
    "updatedAt": { "type": "string", "format": "date-time" },
    "status": { "enum": ["review-required", "passed", "failed"] },
    "brief": {
      "type": "object",
      "required": [
        "title",
        "topic",
        "objective",
        "audience",
        "desiredConclusion",
        "density",
        "constraints"
      ],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "topic": { "type": "string", "minLength": 1 },
        "objective": { "type": "string", "minLength": 1 },
        "audience": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "desiredConclusion": { "type": "string", "minLength": 1 },
        "density": { "enum": ["speaker-led", "balanced", "dense"] },
        "constraints": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "title", "location", "claims"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "type": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "location": { "type": "string" },
          "claims": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "text",
                "evidenceType",
                "attribution"
              ],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "text": { "type": "string", "minLength": 1 },
                "evidenceType": {
                  "enum": ["source", "user-provided", "demonstration"]
                },
                "attribution": { "type": "string" }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "narrative": {
      "type": "object",
      "required": [
        "openingPromise",
        "arc",
        "sections",
        "conclusion",
        "nextAction"
      ],
      "properties": {
        "openingPromise": { "type": "string", "minLength": 1 },
        "arc": { "type": "string", "minLength": 1 },
        "sections": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "purpose"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "purpose": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        },
        "conclusion": { "type": "string", "minLength": 1 },
        "nextAction": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "slides": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "purpose",
          "narrativeRole",
          "contentShape",
          "intent",
          "signals",
          "itemCount",
          "density",
          "requestedLayout",
          "source",
          "evidenceMode",
          "sourceClaimIds",
          "emphasisCandidates",
          "selectedLayout",
          "styleTreatment",
          "prototypeSlide",
          "candidates",
          "rejections",
          "scoreGap",
          "confidence"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "purpose": { "type": "string", "minLength": 1 },
          "narrativeRole": { "type": "string", "minLength": 1 },
          "contentShape": { "type": "string", "minLength": 1 },
          "intent": { "type": "string", "minLength": 1 },
          "signals": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "itemCount": { "type": "integer", "minimum": 0 },
          "density": { "enum": ["speaker-led", "balanced", "dense"] },
          "requestedLayout": { "type": ["string", "null"] },
          "source": { "enum": ["inferred", "user"] },
          "evidenceMode": {
            "enum": ["none", "sourced", "demonstration"]
          },
          "sourceClaimIds": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "emphasisCandidates": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "role",
                "text",
                "category",
                "rationale",
                "source",
                "priority",
                "treatments"
              ],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "role": { "type": "string", "minLength": 1 },
                "text": { "type": "string", "minLength": 1 },
                "category": {
                  "enum": [
                    "user-request",
                    "core-conclusion",
                    "key-metric",
                    "decision-action",
                    "contrast"
                  ]
                },
                "rationale": { "type": "string", "minLength": 1 },
                "source": { "enum": ["inferred", "user"] },
                "priority": { "enum": ["primary", "secondary"] },
                "treatments": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "enum": ["bold", "enlarge", "color", "highlight"]
                  }
                }
              },
              "additionalProperties": false
            }
          },
          "selectedLayout": { "type": "string", "minLength": 1 },
          "styleTreatment": { "type": "string", "minLength": 1 },
          "prototypeSlide": { "type": "string", "minLength": 1 },
          "candidates": { "type": "array", "minItems": 1 },
          "rejections": { "type": "array" },
          "scoreGap": { "type": "number" },
          "confidence": { "enum": ["high", "medium", "low"] }
        },
        "additionalProperties": false
      }
    },
    "coverage": {
      "type": "object",
      "required": [
        "sourceCount",
        "claimCount",
        "usedClaimIds",
        "unusedClaimIds"
      ],
      "properties": {
        "sourceCount": { "type": "integer", "minimum": 0 },
        "claimCount": { "type": "integer", "minimum": 0 },
        "usedClaimIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "unusedClaimIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "findings": {
      "type": "object",
      "required": ["blockers", "warnings"],
      "properties": {
        "blockers": { "type": "array" },
        "warnings": { "type": "array" }
      },
      "additionalProperties": false
    },
    "review": { "type": ["object", "null"] }
  },
  "additionalProperties": false
}
